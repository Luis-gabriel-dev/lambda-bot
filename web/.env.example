# Copie para .env.local e preencha. NUNCA comite segredos.

# Banco — o mesmo Postgres do bot.
#   Dev local:  postgresql://lambda:lambda@localhost:5433/lambda?schema=public
#   Producao:   postgresql://USUARIO:SENHA@ic-postgresql-0EL5:5432/lambda?schema=public
DATABASE_URL=

# Login com Discord (Auth.js)
AUTH_SECRET=
