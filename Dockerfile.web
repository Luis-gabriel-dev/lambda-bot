# Imagem do SITE (dashboard Next.js). Build a partir da RAIZ do repo,
# porque o site sincroniza o schema do Prisma de ../prisma.
FROM node:22-slim

# OpenSSL é exigido pelo engine do Prisma.
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Schema do bot (fonte única; o site copia a partir daqui no build).
COPY prisma ./prisma

# 1) Dependências do site (camada cacheável).
COPY web/package.json web/package-lock.json ./web/
WORKDIR /app/web
RUN npm ci

# 2) Código do site.
COPY web/ ./

# 3) prebuild (sincroniza o schema + prisma generate) + next build.
RUN npm run build

EXPOSE 3000
# next start escuta na porta 3000.
CMD ["npm", "start"]
