# Variáveis do SITE em produção. Copie para .env.web na VPS e preencha. NUNCA comite segredos.

# Mesmo Postgres do bot (rede interna do Docker).
DATABASE_URL=postgresql://USUARIO:SENHA@ic-postgresql-0EL5:5432/lambda?schema=public

# Auth.js — login com Discord (app de PRODUCAO no Developer Portal)
AUTH_SECRET=
