// Prisma schema — SQLite por padrão, troque o provider para "postgresql" no futuro
// sem reescrever as queries. Rode `npm run db:push` após alterar este arquivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Advertências (warns) aplicadas a um membro.
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
}

/// Ciclo de penalidade por advertências: quando o mute (atingir 4 warns) acaba e
/// quando as advertências devem ser zeradas (1 semana depois), com flag de aviso.
model WarnPenalty {
  id              Int      @id @default(autoincrement())
  guildId         String
  userId          String
  muteEndsAt      DateTime
  resetAt         DateTime
  muteEndNotified Boolean  @default(false)

  @@unique([guildId, userId])
  @@index([resetAt])
}

/// Configuração geral por servidor (cargos automáticos de entrada, categoria de tickets).
model GuildConfig {
  guildId          String  @id
  autoRoleId       String? // cargo dado a membros humanos ao entrar
  botRoleId        String? // cargo dado a bots ao entrar
  ticketCategoryId String? // categoria onde os canais de ticket são criados
}

/// Ticket aberto (1 canal = 1 ticket).
model Ticket {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String   @unique
  openerId  String
  type      String
  createdAt DateTime @default(now())

  @@index([guildId, openerId])
}

/// Cargos que podem ver/atender os tickets, por servidor.
model TicketSupportRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Canais de log por tipo (bans, entrada, saída, ...) e por servidor.
model LogChannel {
  id        Int    @id @default(autoincrement())
  guildId   String
  type      String
  channelId String

  @@unique([guildId, type])
}

/// Cargos autorizados a usar um comando restrito, por servidor.
model CommandPermission {
  id      Int    @id @default(autoincrement())
  guildId String
  command String
  roleId  String

  @@unique([guildId, command, roleId])
  @@index([guildId, command])
}
