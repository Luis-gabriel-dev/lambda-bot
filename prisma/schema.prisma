// Prisma schema — SQLite por padrão, troque o provider para "postgresql" no futuro
// sem reescrever as queries. Rode `npm run db:push` após alterar este arquivo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Advertências (warns) aplicadas a um membro.
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  @@index([guildId, userId])
}

/// Ciclo de penalidade por advertências: quando o mute (atingir 4 warns) acaba e
/// quando as advertências devem ser zeradas (1 semana depois), com flag de aviso.
model WarnPenalty {
  id              Int      @id @default(autoincrement())
  guildId         String
  userId          String
  muteEndsAt      DateTime
  resetAt         DateTime
  muteEndNotified Boolean  @default(false)

  @@unique([guildId, userId])
  @@index([resetAt])
}

/// Configuração geral por servidor (cargos automáticos de entrada, categoria de tickets).
model GuildConfig {
  guildId          String  @id
  autoRoleId       String? // cargo dado a membros humanos ao entrar
  botRoleId        String? // cargo dado a bots ao entrar
  ticketCategoryId String? // categoria onde os canais de ticket são criados
  welcomeChannelId      String? // canal público de boas-vindas
  welcomeImageUrl       String? // imagem/gif fixo do embed de boas-vindas
  welcomeRulesChannelId String? // canal de regras citado nas boas-vindas
  welcomeColorChannelId String? // canal de cor de perfil citado nas boas-vindas
  welcomeColor          Int? // cor fixa do embed (null = aleatória entre 40 cores)
  trapChannelId         String? // canal-armadilha: quem mandar mensagem aqui leva kick
  dmImageUrl            String? // imagem padrão usada em todos os embeds de DM do bot
  bumpChannelId         String? // canal exclusivo de /bump (apaga o que não for /bump)
  partnerAnnounceChannelId String? // canal onde o anúncio de parceria (texto + convite) é postado
  partnerNotifyRoleId      String? // cargo @parceria marcado no anúncio
  partnerPublicChannelId   String? // canal do embed público "fez parceria"
  partnerImageUrl          String? // imagem customizável do embed público de parceria
  partnerCategoryId        String? // categoria onde os canais de ticket de parceria são criados
}

/// Cargos autorizados a ver/confirmar tickets de parceria.
model PartnerSupportRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Contador de parcerias fechadas por administrador (métrica por servidor).
model PartnerStat {
  id      Int    @id @default(autoincrement())
  guildId String
  userId  String
  count   Int    @default(0)

  @@unique([guildId, userId])
}

/// Ticket de parceria aberto (1 canal = 1 pedido de parceria).
model Partnership {
  id           Int      @id @default(autoincrement())
  guildId      String
  channelId    String   @unique
  openerId     String
  inviteUrl    String? // último convite detectado
  inviteServer String? // nome do servidor do convite (via fetchInvite)
  pitchText    String? // texto/mensagem que acompanha o convite
  status       String   @default("aberto") // aberto | aprovado | recusado
  createdAt    DateTime @default(now())

  @@index([guildId, openerId])
}

/// Cargos que NÃO levam kick no canal-armadilha (/trap).
model TrapExemptRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Cargos que podem mandar qualquer coisa no canal de bump (além de bots).
model BumpExemptRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Ticket aberto (1 canal = 1 ticket).
model Ticket {
  id        Int      @id @default(autoincrement())
  guildId   String
  channelId String   @unique
  openerId  String
  type      String
  createdAt DateTime @default(now())

  @@index([guildId, openerId])
}

/// Cargos que podem ver/atender os tickets, por servidor.
model TicketSupportRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Sorteio (giveaway). 1 mensagem = 1 sorteio.
model Giveaway {
  id            Int             @id @default(autoincrement())
  guildId       String
  channelId     String
  messageId     String          @unique
  prize         String
  winnerCount   Int             @default(1)
  hostId        String
  endsAt             DateTime
  ended              Boolean         @default(false)
  excludeRoleId      String? // cargo que NÃO pode participar
  blockNitro         Boolean         @default(false) // bloqueia sinais de Nitro (best-effort)
  minMessages        Int? // mínimo de mensagens exigidas
  messageWindowHours Int? // janela (em horas) para contar as mensagens
  requirement        String? // requisito em texto livre (exibido, não enforçado)
  entries            GiveawayEntry[]

  @@index([ended, endsAt])
}

/// Enquete (votação com botões). 1 mensagem = 1 enquete.
model Poll {
  id        Int          @id @default(autoincrement())
  guildId   String
  channelId String
  messageId String       @unique
  question      String
  color         Int?
  imageUrl      String?
  closed        Boolean      @default(false)
  endsAt        DateTime? // auto-encerra quando passar (null = manual)
  deleteAfterMs Int? // apagar a mensagem N ms após encerrar (null = nunca)
  deleteAt      DateTime? // momento absoluto para apagar (definido ao encerrar)
  createdAt     DateTime     @default(now())
  options       PollOption[]
  votes         PollVote[]
}

/// Opção de uma enquete.
model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  idx    Int
  text   String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, idx])
}

/// Voto de um usuário (1 voto por enquete = escolha única).
model PollVote {
  id     Int    @id @default(autoincrement())
  pollId Int
  userId String
  idx    Int
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

/// Configuração do automod por servidor.
model AutomodConfig {
  guildId          String  @id
  antiSpam         Boolean @default(false)
  antiBigMessage   Boolean @default(false)
  antiInvite       Boolean @default(false)
  antiMassMention  Boolean @default(false)
  antiForward      Boolean @default(false)
  antiLink         Boolean @default(false)
  antiGif          Boolean @default(false)
  antiRaid         Boolean @default(false) // disparo em vários canais ao mesmo tempo (conta hackeada / bot)
  linkMode         String  @default("whitelist") // "whitelist" (bloqueia tudo, libera lista) ou "blacklist" (libera tudo, bloqueia lista)
  maxMessageLength Int     @default(600)
  maxMentions      Int     @default(5)
}

/// Domínios liberados (whitelist) do módulo anti-link, por servidor.
model AutomodLinkWhitelist {
  id      Int    @id @default(autoincrement())
  guildId String
  domain  String

  @@unique([guildId, domain])
}

/// Domínios bloqueados (blacklist) do módulo anti-link, por servidor (modo blacklist).
model AutomodLinkBlacklist {
  id      Int    @id @default(autoincrement())
  guildId String
  domain  String

  @@unique([guildId, domain])
}

/// Cargos autorizados a enviar GIFs quando o módulo anti-GIF está ligado.
model AutomodGifRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Liberação de links por cargo (anti-link). domain = "*" significa todos os links.
model AutomodLinkRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String
  domain  String

  @@unique([guildId, roleId, domain])
}

/// Restringe um domínio da whitelist a canais/categorias específicos.
/// Se um domínio tem linhas aqui, só é permitido nesses canais; sem linhas = em todos.
model AutomodLinkChannel {
  id        Int    @id @default(autoincrement())
  guildId   String
  domain    String
  channelId String

  @@unique([guildId, domain, channelId])
}

/// Canais/categorias liberados de um módulo do automod (bigmessage/invite).
model AutomodAllow {
  id        Int    @id @default(autoincrement())
  guildId   String
  feature   String
  channelId String

  @@unique([guildId, feature, channelId])
}

/// Cargos isentos de todo o automod.
model AutomodExemptRole {
  id      Int    @id @default(autoincrement())
  guildId String
  roleId  String

  @@unique([guildId, roleId])
}

/// Canais de "mini Instagram" — vários por servidor, cada um com seu aviso.
model InstagramChannel {
  id                 Int     @id @default(autoincrement())
  guildId            String
  channelId          String  @unique
  disclaimerImageUrl String? // imagem fixa do aviso desse canal
  disclaimerColor    Int? // cor do embed de informação (null = padrão)
}

/// Post do mini Instagram (1 mensagem do bot = 1 post).
model InstaPost {
  id           Int         @id @default(autoincrement())
  guildId      String
  channelId    String
  messageId    String      @unique
  threadId     String?     @unique
  authorId     String
  title        String? // título opcional do post (definido pela pessoa)
  caption      String? // legenda (texto enviado junto da mídia)
  color        Int? // cor do card (cor predominante da foto; null = padrão)
  commentCount Int         @default(0)
  createdAt    DateTime    @default(now())
  likes        InstaLike[]
}

/// Curtida em um post.
model InstaLike {
  id     Int       @id @default(autoincrement())
  postId Int
  userId String
  post   InstaPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

/// Configuração da economia (kurocoins) por servidor.
model EconomyConfig {
  guildId             String    @id
  dropChannelId       String?
  dropIntervalMinutes Int?
  dropMin             Int       @default(10)
  dropMax             Int       @default(500)
  expireDeleteMs      Int? // apagar a mensagem de "ninguém coletou" após N ms (null = nunca)
  claimedDeleteMs     Int? // apagar a mensagem de "coletado por X" após N ms (null = nunca)
  lastDropAt          DateTime?
}

/// GIFs usados nos drops de dinheiro.
model EconomyGif {
  id      Int    @id @default(autoincrement())
  guildId String
  url     String
}

/// Carteira de um membro (kurocoins).
model Wallet {
  id             Int      @id @default(autoincrement())
  guildId        String
  userId         String
  balance        Int      @default(0)
  totalCollected Int      @default(0)
  collectCount   Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([guildId, userId])
}

/// Drop de dinheiro (1 mensagem = 1 drop). Primeiro a coletar leva.
model Drop {
  id          Int      @id @default(autoincrement())
  guildId     String
  channelId   String
  messageId   String   @unique
  amount      Int
  claimedById String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([guildId, active])
}

/// Atividade de mensagens agregada por hora (para requisitos de sorteio).
model MessageActivity {
  id         Int    @id @default(autoincrement())
  guildId    String
  userId     String
  hourBucket Int // epoch em horas (Date.now() / 3600000)
  count      Int    @default(0)

  @@unique([guildId, userId, hourBucket])
  @@index([hourBucket])
}

/// Participação de um usuário em um sorteio.
model GiveawayEntry {
  id         Int      @id @default(autoincrement())
  giveawayId Int
  userId     String
  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)

  @@unique([giveawayId, userId])
}

/// Canais de log por tipo (bans, entrada, saída, ...) e por servidor.
model LogChannel {
  id        Int    @id @default(autoincrement())
  guildId   String
  type      String
  channelId String

  @@unique([guildId, type])
}

/// Cargos autorizados a usar um comando restrito, por servidor.
model CommandPermission {
  id      Int    @id @default(autoincrement())
  guildId String
  command String
  roleId  String

  @@unique([guildId, command, roleId])
  @@index([guildId, command])
}
