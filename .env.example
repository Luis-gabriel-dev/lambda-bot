# Copie para .env e preencha. NUNCA comite o .env de verdade (já está no .gitignore).

# Token do bot (Developer Portal -> sua app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information)
CLIENT_ID=

# ID do servidor onde os comandos sao registrados
GUILD_ID=

# Seu ID de usuario (dono do bot): bypassa permissoes e libera o /kuro
OWNER_ID=

# Banco de dados (PostgreSQL em dev e prod):
#   Dev local (docker-compose.dev.yml):  postgresql://lambda:lambda@localhost:5433/lambda?schema=public
#   Producao (VPS):                      postgresql://USUARIO:SENHA@ic-postgresql-0EL5:5432/lambda?schema=public
DATABASE_URL="postgresql://lambda:lambda@localhost:5433/lambda?schema=public"
